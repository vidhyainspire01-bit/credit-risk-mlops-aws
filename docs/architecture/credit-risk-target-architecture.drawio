ldown check" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDEEF5;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2075" y="495" width="210" height="58" as="geometry"/></mxCell><mxCell id="n221" value="&lt;b&gt;Map&lt;/b&gt; (parallel)&lt;br&gt;C1 refresh, C2 recent window,&lt;br&gt;C3 time decay, C4 feature&lt;br&gt;re-selection (approved catalog)" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDEEF5;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2075" y="575" width="210" height="78" as="geometry"/></mxCell><mxCell id="n222" value="StartPipelineExecution&lt;br&gt;+ poll until done" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDEEF5;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2075" y="675" width="210" height="44" as="geometry"/></mxCell><mxCell id="n223" value="&lt;b&gt;compare_candidates&lt;/b&gt;&lt;br&gt;best KS kept as Pending,&lt;br&gt;others Rejected + evidence" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FDEEF5;strokeColor=#E7157B;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2075" y="740" width="210" height="64" as="geometry"/></mxCell><mxCell id="n224" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n218" target="n220"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n225" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n220" target="n221"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n226" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n221" target="n222"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n227" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n222" target="n223"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n228" value="ALARM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#545B64;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n206" target="n218"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1814" y="640"/><mxPoint x="2010" y="640"/><mxPoint x="2010" y="394"/></Array></mxGeometry></mxCell><mxCell id="n229" value="release pipeline" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n222" target="n149"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2180" y="940"/><mxPoint x="720" y="940"/><mxPoint x="720" y="482"/></Array></mxGeometry></mxCell><mxCell id="n230" value="PendingManualApproval" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.6;strokeColor=#E7157B;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n223" target="n168"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2300" y="772"/><mxPoint x="2300" y="300"/><mxPoint x="1084" y="300"/></Array></mxGeometry></mxCell><mxCell id="n231" value="11" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2050" y="335" width="26" height="26" as="geometry"/></mxCell><mxCell id="n232" value="Cross-cutting: security, governance, cost (applies to every phase)" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#FDF2F4;strokeColor=#DD344C;dashed=1;dashPattern=8 4;verticalAlign=top;align=center;fontStyle=1;fontSize=13;fontColor=#232F3E;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="1010" width="2250" height="170" as="geometry"/></mxCell><mxCell id="n233" value="KMS CMK&lt;br&gt;S3, ECR, endpoints,&lt;br&gt;SNS, Lambda env" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="120" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n234" value="IAM: GitHub OIDC roles&lt;br&gt;scoped by branch;&lt;br&gt;SoD deny on approval" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="420" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n235" value="Secrets Manager&lt;br&gt;GitHub dispatch token" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="720" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n236" value="Terraform (platform)&lt;br&gt;+ CloudFormation&lt;br&gt;(endpoint stacks)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1020" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n237" value="Budgets + tags&lt;br&gt;Project, ModelId,&lt;br&gt;CostCentre" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cost_explorer;" vertex="1" parent="1"><mxGeometry x="1320" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n238" value="make down&lt;br&gt;+ cost_check.py&lt;br&gt;(zero leftovers)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;" vertex="1" parent="1"><mxGeometry x="1620" y="1055" width="44" height="44" as="geometry"/></mxCell><mxCell id="n239" value="&lt;b&gt;Responsible AI&lt;/b&gt;: SEX / MARRIAGE never features (Clarify facets only); monotonic constraints; top-5 reason codes per decision; Model Card + lineage per version; fallback = MANUAL_REVIEW, never auto-approve." style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#DD344C;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1890" y="1045" width="400" height="110" as="geometry"/></mxCell><mxCell id="n240" value="12" style="ellipse;html=1;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1846" y="1030" width="26" height="26" as="geometry"/></mxCell><mxCell id="n241" value="&lt;b style=&quot;font-size:14px&quot;&gt;Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1.&lt;/b&gt; Extract lands in S3 raw (KMS). Glue curates with Data Quality rules, quarantines bad rows, publishes freshness. Customer history goes to Feature Store (offline for training, online for serving).&lt;br&gt;&lt;br&gt;&lt;b&gt;2.&lt;/b&gt; DS explores in Studio, tracks runs in MLflow, moves logic into the shared credit_features library.&lt;br&gt;&lt;br&gt;&lt;b&gt;3.&lt;/b&gt; PR: lint, tests, IaC and image scans, container contract test, smoke training (same step scripts in the SageMaker image, synthetic data).&lt;br&gt;&lt;br&gt;&lt;b&gt;4.&lt;/b&gt; Merge to develop: full pipeline on dev data, version lands in credit-pd-dev only.&lt;br&gt;&lt;br&gt;&lt;b&gt;5.&lt;/b&gt; Merge to main: release pipeline. Gate on KS floor, champion and fairness; registered as PendingManualApproval with full provenance.&lt;br&gt;&lt;br&gt;&lt;b&gt;6.&lt;/b&gt; Model Risk approves (separate role). EventBridge -&gt; Lambda -&gt; GitHub deploy.yml. CloudTrail + inventory.&lt;br&gt;&lt;br&gt;&lt;b&gt;7.&lt;/b&gt; Staging endpoint from the registry version; parity, contract, load checks (G4).&lt;br&gt;&lt;br&gt;&lt;b&gt;8.&lt;/b&gt; CAB approves; prod shadow, then canary with alarm rollback, then A/B, then full.&lt;br&gt;&lt;br&gt;&lt;b&gt;9.&lt;/b&gt; Request: API -&gt; Lambda (validate, knockout, online features) -&gt; endpoint (PD + reason codes) -&gt; band from SSM -&gt; decision log. Any failure returns MANUAL_REVIEW.&lt;br&gt;&lt;br&gt;&lt;b&gt;10.&lt;/b&gt; Capture -&gt; Model Monitor (data quality, model quality with ground truth) -&gt; CloudWatch -&gt; SNS; daily report at 09:00.&lt;br&gt;&lt;br&gt;&lt;b&gt;11.&lt;/b&gt; Drift alarm -&gt; Step Functions: triage (no retrain on bad data), parallel candidates, best one registered as pending. Re-enters at step 6. Never auto-deploys.&lt;br&gt;&lt;br&gt;&lt;b&gt;12.&lt;/b&gt; One-day lifecycle: make up, make down, cost check.&lt;br&gt;&lt;hr&gt;&lt;b&gt;Standard for every model&lt;/b&gt;: one repo template, one pipeline with per-environment parameters, one deployment template, the same gates G0-G8. A new model = a new feature library, config and registry group; everything else is reused." style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;spacing=10;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="2360" y="85" width="440" height="1115" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>